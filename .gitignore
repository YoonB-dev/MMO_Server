.vs/
*.user
*.suo
*.aps
x64/

# 빌드 결과
Binary/
Libraries/Libs/ServerCore/

# Protobuf 라이브러리 (Debug lib 약 88MB -> 저장소에 넣지 않고 따로 복사)
Libraries/Libs/Protobuf/

# 패킷 생성 결과 (빌드할 때마다 Common/protoc-21.12-win64/bin/GenPackets.bat이 만듦)
